# Every auth-relevant value is externalized here — nothing is hardcoded in source. Copy
# this file to .env and fill in the values from your own Auth0 tenant (see docs/SETUP.md).

# --- OIDC provider (Auth0) ---
# Trailing slash included — must exactly match the `iss` claim Auth0 issues.
OIDC_ISSUER_URI=https://YOUR_TENANT.auth0.com/
OIDC_CLIENT_ID=replace-with-auth0-application-client-id
OIDC_CLIENT_SECRET=replace-with-auth0-application-client-secret
# Must exactly match one of the Auth0 application's Allowed Callback URLs.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid profile email offline_access
# The `identifier` of the API you create in Auth0 (Applications -> APIs). Required so Auth0
# issues a JWT access token (rather than opaque) for the backend to validate.
OIDC_AUDIENCE=https://api.authbridge.local
# Where Auth0 sends the browser after RP-Initiated Logout completes.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# --- Session cookie ---
# A long random string (e.g. `openssl rand -base64 32`). Must be IDENTICAL across every
# running instance for cookie sessions to work behind a load balancer — see README.md.
COOKIE_SECRET=replace-with-a-long-random-string

# --- Backend ---
# In docker-compose this is the in-network service name (http://backend:8080), not
# localhost, since the token exchange and backend calls happen server-side in this container.
BACKEND_API_URL=http://localhost:8080

# --- Optional: chained logout to Entra (best-effort, see docs/SETUP.md) ---
# Entra's own RP-Initiated Logout endpoint: https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/logout
# Leave unset to skip chaining and just end the Auth0/app session.
# UPSTREAM_END_SESSION_URL=
# Absolute base URL of this app, used to build the callback Entra's logout redirects back
# to. Defaults to the request's own origin if unset; set explicitly behind a load balancer.
# APP_BASE_URL=http://localhost:3000
