# Spring Boot does NOT read .env files natively. This file documents the env vars
# application.yml expects — supply them via docker-compose's `env_file` (see
# ../docker-compose.yml), your IDE's run configuration, or `export $(cat .env | xargs)`
# locally. In AWS, set these as the ECS task definition's environment / from SSM Parameter
# Store (see docs/SETUP.md — avoid Secrets Manager, it's not free-tier).

# Auth0 tenant issuer, WITH the trailing slash (Auth0 issues tokens with `iss` set exactly
# to this value, trailing slash included). Spring auto-discovers JWKS from
# <this>/.well-known/openid-configuration — nothing else to configure for signature checks.
OIDC_ISSUER_URI=https://YOUR_TENANT.auth0.com/

# The `identifier` of the API you create in Auth0 (Applications -> APIs). Must match the
# `audience` the frontend requests at /authorize, or Auth0 will issue an opaque access token
# instead of a JWT and this backend will not be able to validate it as one.
OIDC_AUDIENCE=https://api.authbridge.local

# Name of the custom-namespaced JWT claim carrying the caller's group/role identifiers.
# Must match the claim name your Auth0 Action sets (see docs/SETUP.md). Auth0 requires
# custom claims to be namespaced as a URI.
AUTHZ_ROLES_CLAIM=https://authbridge.app/groups

# The GUID -> app-role mapping is NOT set via env var (see the comment in
# application.yml's app.authorization.role-mapping for why) — edit that file directly.
